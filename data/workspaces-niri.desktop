[Desktop Entry]
Name=Workspaces Niri
Comment=Switch between niri workspaces in the panel
Type=Application
Exec=workspaces-niri
Terminal=false
Categories=COSMIC;
Keywords=COSMIC;Applet;Workspace;niri;
Icon=com.system76.CosmicAppletWorkspaces
StartupNotify=true
NoDisplay=true
X-CosmicApplet=true
X-HostWaylandDisplay=true
X-OverflowPriority=5
X-OverflowMinSize=8
