[Desktop Entry]
Name=App Tray Niri
Comment=Launch pinned apps and manage open windows (niri backend)
Type=Application
Exec=app-tray-niri
Terminal=false
Categories=COSMIC;
Keywords=COSMIC;Applet;App;Tray;List;Task;Bar;niri;
Icon=com.system76.CosmicAppList
StartupNotify=true
NoDisplay=true
X-CosmicApplet=true
X-MinimizeApplet=5
X-OverflowPriority=100
X-OverflowMinSize=4
X-HostWaylandDisplay=true
